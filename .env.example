# Hopsworks (https://console.hopsworks.ai)
HOPSWORKS_HOST=eu-west.cloud.hopsworks.ai
HOPSWORKS_PORT=443
HOPSWORKS_PROJECT=your_project_name
HOPSWORKS_API_KEY=your_api_key
# "python" for local execution, "spark" for Spark jobs
HOPSWORKS_ENGINE=python

# MLflow (optional; default: in-cluster server http://mlflow.mlflow.svc.cluster.local)
# For local runs use e.g. sqlite:////absolute/path/to/mlflow.db
# MLFLOW_TRACKING_URI=http://mlflow.mlflow.svc.cluster.local

# S3 / Rook-Ceph object storage (src/s3_credentials.py).
# In the cluster these are injected by the manifests from secretKeyRef
# "s3-credentials" - nothing ever calls kubectl. Export them only for local runs
# that read or write s3://oilprice-features, s3://oilprice-models or s3://traindata.
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_ENDPOINT_URL=http://rook-ceph-rgw-objectstore.rook-ceph.svc:8080
# S3_ENDPOINT_URL=http://127.0.0.1:8080   # optional alias, wins over AWS_ENDPOINT_URL

