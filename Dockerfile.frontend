# Frontend: Flask app (src/frontend/app.py) that proxies to the inference service
FROM python:3.12-slim

WORKDIR /app

COPY src/frontend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/frontend .

ENV PYTHONPATH=/app

# run as a dedicated non-root user (see k8s securityContext runAsNonRoot)
RUN useradd -m appuser && chown -R appuser /app
USER appuser

EXPOSE 5000

CMD ["gunicorn", "--bind", "0.0.0.0:5000", "app:app"]